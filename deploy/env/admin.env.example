VANGUARD_ADMIN_DIR=/var/lib/vanguard/admin
VANGUARD_ROOT_CERT=/etc/vanguard/root.crt
VANGUARD_CA_URL=https://192.168.100.10:8080
VANGUARD_SERVER_URL=https://192.168.100.20:8081
VANGUARD_CA_TOKEN=
VANGUARD_SERVER_TOKEN=
# Independent random secret; never use a login password.
VANGUARD_SESSION_SECRET=
