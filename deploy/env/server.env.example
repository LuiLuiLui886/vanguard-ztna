VANGUARD_SERVER_DIR=/var/lib/vanguard/server
VANGUARD_ROOT_CERT=/etc/vanguard/root.crt
VANGUARD_CA_URL=https://192.168.100.10:8080
# Generate a different token from the CA token.
VANGUARD_SERVER_TOKEN=
# Optional: enable only after installing the --application-policy firewall.
# VANGUARD_RESOURCE_POLICY=/etc/vanguard/resource-policy.json
