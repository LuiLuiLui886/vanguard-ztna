[Unit]
Description=VanGuard peer revocation and lease daemon
After=network-online.target wg-quick@wg0.service
Wants=network-online.target
BindsTo=wg-quick@wg0.service

[Service]
User=root
EnvironmentFile=/etc/vanguard/server.env
ExecStart=/opt/vanguard/venv/bin/vanguard-daemon
# Loss of the reconciler shuts down the interface and its dependent API.
ExecStopPost=/usr/bin/systemctl --no-block stop wg-quick@wg0.service
TimeoutStopSec=20
UMask=0077
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/vanguard/server

[Install]
WantedBy=multi-user.target
